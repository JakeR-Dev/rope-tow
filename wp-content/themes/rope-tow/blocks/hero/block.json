{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rope-tow/hero",
  "title": "Hero",
  "category": "theme",
  "description": "Hero block with style and pinache",
  "supports": {
    "html": false,
    "align": ["full", "wide"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h1"
    },
    "subtitleTag": {
      "type": "string",
      "default": "p"
    },
    "cta1Label": {
			"type": "string",
			"default": "Learn More"
		},
    "cta1Url": {
			"type": "string",
			"default": ""
		},
    "cta2Label": {
			"type": "string",
			"default": "Get Started"
		},
    "cta2Url": {
			"type": "string",
			"default": ""
		},
    "backgroundImage": {
      "type": "object",
      "default": {}
    },
    "paddingTop": {
      "type": "string",
      "default": "medium"
    },
    "paddingBottom": {
      "type": "string",
      "default": "medium"
    },
		"textColor": {
			"type": "string",
			"default": "light"
		},
		"backgroundColor": {
			"type": "string",
			"default": "brand-primary"
		},
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll"
		}
  },
  "render": "file:./hero.php"
}