{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rope-tow/side-by-side",
  "title": "Side-By-Side",
  "category": "the-goods",
  "description": "Side-by-side content block with style and flair",
  "supports": {
    "html": false,
    "align": ["full", "wide"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "pretitle": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h1"
    },
    "pretitleTag": {
      "type": "string",
      "default": "h6"
    },
    "subtitleTag": {
      "type": "string",
      "default": "p"
    },
    "cta1Label": {
			"type": "string",
			"default": "Learn More"
		},
    "cta1Url": {
			"type": "string",
			"default": ""
		},
		"cta1Style": {
			"type": "string",
			"default": "primary"
		},
    "cta2Label": {
			"type": "string",
			"default": "Get Started"
		},
    "cta2Url": {
			"type": "string",
			"default": ""
		},
		"cta2Style": {
			"type": "string",
			"default": "secondary"
		},
    "image": {
      "type": "object",
      "default": {}
    },
    "verticalAlignment": {
      "type": "string",
      "default": "center"
    },
    "imageBorderRadius": {
      "type": "number",
      "default": 0
    },
    "imageSide":  {
      "type": "string",
      "default": "right"
    }
  },
  "example": {
    "attributes": {
      "pretitle": "Why Teams Choose Us",
      "title": "Everything You Need In One Section",
      "subtitle": "Combine strong messaging with clear calls to action.",
      "titleTag": "h2",
      "pretitleTag": "h6",
      "subtitleTag": "p",
      "cta1Label": "Get Started",
      "cta1Url": "#",
      "cta1Style": "primary",
      "cta2Label": "See Pricing",
      "cta2Url": "#",
      "cta2Style": "secondary",
      "verticalAlignment": "center",
      "imageBorderRadius": "0",
      "imageSide": "right"
    }
  },
  "render": "file:./side-by-side.php"
}