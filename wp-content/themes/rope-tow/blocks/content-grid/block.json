{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rope-tow/content-grid",
  "title": "Content Grid",
  "category": "the-goods",
  "description": "Content Grid block with flexibility and style",
  "supports": {
    "html": false,
    "align": ["full", "wide"]
  },
  "attributes": {
    "gridColumns": {
      "type": "string",
      "default": "span-4"
    },
    "gridItemBorderRadius": {
      "type": "number",
      "default": 8
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "pretitle": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h1"
    },
    "pretitleTag": {
      "type": "string",
      "default": "h6"
    },
    "subtitleTag": {
      "type": "string",
      "default": "p"
    },
    "items": {
      "type": "array",
      "default": []
    },
    "cta1Label": {
			"type": "string",
			"default": "Learn More"
		},
    "cta1Url": {
			"type": "string",
			"default": ""
		},
		"cta1Style": {
			"type": "string",
			"default": "primary"
		},
    "cta2Label": {
			"type": "string",
			"default": "Get Started"
		},
    "cta2Url": {
			"type": "string",
			"default": ""
		},
		"cta2Style": {
			"type": "string",
			"default": "secondary"
		}
  },
  "render": "file:./content-grid.php"
}