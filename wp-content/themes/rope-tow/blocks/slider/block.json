{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rope-tow/slider",
  "title": "Slider",
  "category": "the-goods",
  "description": "Slider block that exudes subtle confidence.",
  "supports": {
    "html": false,
    "align": ["full", "wide"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "pretitle": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h1"
    },
    "pretitleTag": {
      "type": "string",
      "default": "h6"
    },
    "subtitleTag": {
      "type": "string",
      "default": "p"
    },
    "sliderStyle": {
      "type": "string",
      "default": "single"
    },
    "items": {
      "type": "array",
      "default": []
    },
    "cta1Label": {
			"type": "string",
			"default": "Learn More"
		},
    "cta1Url": {
			"type": "string",
			"default": ""
		},
		"cta1Style": {
			"type": "string",
			"default": "primary"
		},
    "cta2Label": {
			"type": "string",
			"default": "Get Started"
		},
    "cta2Url": {
			"type": "string",
			"default": ""
		},
		"cta2Style": {
			"type": "string",
			"default": "secondary"
		}
  },
  "example": {
    "attributes": {
      "title": "Browse our offerings",
      "pretitle": "Samples",
      "subtitle": "Pick a package and get started quickly.",
      "titleTag": "h2",
      "pretitleTag": "h6",
      "subtitleTag": "p",
      "backgroundColor": "color-gray-light",
      "textColor": "dark",
      "sliderStyle": "single",
      "items": [
        {
          "title": "Starter",
          "description": "Great for testing and small campaigns.",
          "backgroundColor": "color-white",
          "textColor": "dark",
          "linkLabel": "Learn more",
          "linkUrl": "#",
          "buttonStyle": "primary",
          "image": ""
        }
      ],
      "cta1Label": "Get Started",
      "cta1Url": "#",
      "cta1Style": "primary",
      "cta2Label": "Contact Sales",
      "cta2Url": "#",
      "cta2Style": "secondary"
    }
  },
  "render": "file:./slider.php"
}
